# .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Environment
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data (keep structure, ignore content)
data/novels/*/
!data/novels/.gitkeep

# Logs
logs/
*.log

# Generated outputs
*.mp4
*.wav
*.mp3

# Alexandria reference (used during development only)
alexandria-audiobook-ref/

# Models (downloaded at runtime)
*.safetensors
*.bin
*.pt
*.ckpt

# OS
Thumbs.db
.DS_Store

# Agent config
.agent/